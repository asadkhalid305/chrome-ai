{
  "name": "chrome-ai-teaching-project",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "workshop": "vite --mode workshop",
    "workshop:solutions": "vite --mode workshop-solutions",
    "build:workshop": "tsc -b && vite build --mode workshop",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:all": "npm test && npm run check:exercises",
    "check:exercises": "vitest run --mode exercise-check src/workshop/tests/native-api.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/node": "^24.10.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^28.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
