# Reveal the Chrome-specific intro and per-API availability details.
# true (default): the intro and API details are shown.
# false: everything that names Chrome stays hidden, so a live audience isn't
#   told upfront that these lessons use Chrome built-in AI APIs.
VITE_REVEAL_CHROME=true

# Reveal the separate WebMCP track (website tools for browser agents), which is
# taught apart from the on-device built-in-AI lessons.
# true (default): the WebMCP track is appended after the core lessons.
# false: only the seven built-in-AI lessons appear, keeping a shorter demo
#   focused on built-in inference.
VITE_WEBMCP=true
